# FastAPI base URL (no trailing slash)
VITE_API_URL=http://localhost:8000
# Must match API_V1_PREFIX in the backend .env
VITE_API_PREFIX=/api/v1
# live = real FastAPI + SSE, mock = in-browser generator (no backend needed)
VITE_DATA_SOURCE=live
# blue = brand tones, semantic = green / amber / red
VITE_DECISION_COLORS=blue
# Mock only: demo (0.35–1.2 s between events) or realistic (0.5–2 s, matches the simulator)
VITE_MOCK_RATE=demo
